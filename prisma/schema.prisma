  CONFIRMED
  CHECKED_IN
  WAITING
  WITH_DOCTOR
  RECEPTION
  PROCEDURE
  DONE
  CANCELLED
  RESCHEDULED
}

enum AppointmentSource {
  LEAD
  RECEPTION
  MANAGER
  DOCTOR_PLAN
}

enum RoomKind {
