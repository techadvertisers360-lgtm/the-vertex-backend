// The Vertex Health Command Center — data model (spec §5).
// Conventions: UTC DateTime everywhere; clinic-local calendar dates use @db.Date and
// minutes-from-midnight Ints (Asia/Karachi). Money = BigInt paisa. No hard deletes of
// clinical / financial / audit / history rows (enforced by services + DB triggers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  LEAD_MEMBER
  RECEPTIONIST
  DOCTOR
  ASSISTANT
  OFFICE_BOY
  MANAGER
  MD
  MARKETING_DIRECTOR // Hamza Zafar — NOT Dr Hamza Rasool
  MARKETING_LEAD // Muaz Tahir
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP_DUE
  BOOKED
  NOT_INTERESTED
  UNREACHABLE
}

enum LeadActivityChannel {
  CALL
  WHATSAPP
  NOTE
}

enum LeadActivityResult {
  CONNECTED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  SWITCHED_OFF
  MESSAGE_SENT
  REPLIED
  INTERESTED
  NOT_INTERESTED
  CALL_BACK_LATER
  BOOKED
}

