  RECEPTION_UPCOMING_PROCEDURE
  MANAGER_STOCK_CHECK
  MANAGER_ROOM_VERIFICATION
  MANAGER_LEAVE_IMPACT
  MANAGER_PATIENT_FOLLOWUP
  MANAGER_ASSIGNMENT_MISSING
  MANAGER_MESSAGE_FAILURE
  DOCTOR_AFTERCARE
  ROOM_OPENING
