# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
APP_TIMEZONE=Asia/Karachi

# MySQL 8. DATABASE_URL is a URL: special characters in the user or password MUST be percent-encoded,
# e.g. @ -> %40, # -> %23, % -> %25, : -> %3A, / -> %2F, ? -> %3F, space -> %20.
# Example: password p@ss#1 is written as p%40ss%231
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/the_vertex_health"
# Separate database used by integration tests (it is reset on every test run).
DATABASE_URL_TEST="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/the_vertex_health_test"

# Browser origin(s) allowed by CORS (comma-separated) and public URL used in links.
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
PASSWORD_RESET_TTL_MIN=30
# COOKIE_SECURE defaults to true in production
# COOKIE_SECURE=true

# UploadThing (file storage). Leave empty to use the dev-only stub upload endpoint.
UPLOADTHING_TOKEN=
SIGNED_URL_TTL_SEC=300
# false = UploadThing free plan: clinical files upload public but are only served via the role-checked proxy.
# MUST be true (paid plan with private files) before going live with real patients. See docs/DECISIONS.md D-030.
UPLOADTHING_PRIVATE_FILES=false

# WhatsApp provider — vendor not chosen yet (spec §20). "console" logs messages instead of sending.
WHATSAPP_PROVIDER=console
WHATSAPP_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Google Sheets lead sync (Phase 9b). Paste the service account JSON key on ONE line (or base64 of the file).
# Server-side only; share each Meta lead sheet with the service account email as Viewer. See docs/GOOGLE_SHEETS_SETUP.md.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Demo seed password override (optional)
# SEED_DEMO_PASSWORD=
LOG_LEVEL=info

# ── Serverless / Vercel (D-042, docs/VERCEL_SUPABASE_SETUP.md) ──
# Live updates: socketio (local API process, default) or supabase (Vercel)
REALTIME_PROVIDER=socketio
# Supabase (only live notifications; the database stays on MySQL). Server-only values:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
REALTIME_TOKEN_TTL_SEC=300
# Worker cycle endpoint /api/cron/tick — long random string; unset = endpoint disabled
CRON_SECRET=
# Database CA certificate as PEM text or base64 (for hosts without project files, e.g. Vercel)
DATABASE_CA_CERT=
# Express trust proxy: hops or true (Vercel: true)
TRUST_PROXY=1
